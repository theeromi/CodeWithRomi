# Copy to .env and edit. docker-compose picks this up automatically.

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to false in prod once your user(s) are created
ALLOW_REGISTRATION=true

# Ollama models (must be pulled on the host: `ollama pull <model>`)
# qwen2.5:14b is the practical default — good balance of speed and quality.
# llama3.1:8b is faster but more prone to hallucinating numbers.
# qwen2.5:32b is more accurate on short reasoning but ~10-30x slower per response,
#   and still struggles to enumerate large lists exhaustively (e.g. "sum all
#   transactions" on a long bank statement). Use only for short reasoning queries.
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
