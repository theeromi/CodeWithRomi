# Copy to .env and edit. docker-compose picks this up automatically.

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to false in prod once your user(s) are created
ALLOW_REGISTRATION=true

# Ollama models (must be pulled on the host: `ollama pull llama3.2:3b`)
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
